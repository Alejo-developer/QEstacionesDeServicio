<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/fondo">

    <!-- Barra superior -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/primario"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Precio de Referencia Nacional"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/texto_sobre_primario" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Fijado por la autoridad reguladora"
            android:textSize="13sp"
            android:textColor="@color/texto_sobre_primario"
            android:alpha="0.8"
            android:layout_marginTop="4dp" />
    </LinearLayout>

    <!-- Formulario para fijar nuevo precio -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="0dp"
        app:cardElevation="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="@color/superficie">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Actualizar Precio de Referencia"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/texto_primario"
                android:layout_marginBottom="12dp" />

            <!-- Tipo de combustible + Precio -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginEnd="8dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Combustible"
                        android:textSize="12sp"
                        android:textColor="@color/texto_secundario"
                        android:layout_marginBottom="4dp" />

                    <Spinner
                        android:id="@+id/spinnerCombustibleRef"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@android:drawable/btn_dropdown" />
                </LinearLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Precio (COP/litro)"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/campoPrecioRef"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberDecimal" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <!-- Decreto -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Decreto / Resolución"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_marginBottom="12dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/campoDecretoRef"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/botonGuardarRef"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Publicar Precio de Referencia"
                android:textAllCaps="false"
                android:textSize="15sp"
                app:cornerRadius="12dp"
                app:backgroundTint="@color/primario" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Título historial -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Historial de Precios"
        style="@style/TituloSeccion"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="4dp" />

    <!-- Lista de precios -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/listaPrecios"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="8dp"
        android:clipToPadding="false" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/botonVolverRef"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="@string/volver"
        android:textSize="16sp"
        android:textAllCaps="false"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_margin="16dp" />

</LinearLayout>
