<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/fondo">

    <!-- Barra superior -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/primario"
        android:padding="8dp"
        android:gravity="center_vertical">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/botonVolver"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:text="@string/simbolo_volver"
            android:textColor="@color/texto_sobre_primario"
            style="@style/Widget.Material3.Button.TextButton"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:padding="0dp"
            android:contentDescription="@string/volver" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/titulo_configuracion_precios"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/texto_sobre_primario"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Aviso de exclusión -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#FFF3E0"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/aviso_exclusion_publico"
                    android:textSize="13sp"
                    android:textColor="#BF360C"
                    android:padding="12dp" />
            </androidx.cardview.widget.CardView>

            <!-- Formulario de nueva regla -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/superficie"
                android:layout_marginBottom="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/titulo_nueva_regla"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/primario_oscuro"
                        android:layout_marginBottom="16dp" />

                    <!-- Zona -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/CampoTexto"
                        android:hint="@string/campo_zona"
                        android:layout_marginBottom="12dp"
                        app:hintTextColor="@color/primario_oscuro">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/campoZona"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text"
                            android:textColor="@color/texto_primario"
                            android:maxLines="1" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Tipo de vehículo -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/campo_tipo_vehiculo"
                        android:textSize="14sp"
                        android:textColor="@color/texto_primario"
                        android:layout_marginBottom="4dp" />

                    <Spinner
                        android:id="@+id/selectorTipoVehiculo"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginBottom="12dp"
                        android:background="@android:drawable/btn_dropdown"
                        android:padding="8dp" />

                    <!-- Precio base -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/CampoTexto"
                        android:hint="@string/campo_precio_base"
                        android:layout_marginBottom="12dp"
                        app:hintTextColor="@color/primario_oscuro">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/campoPrecioBase"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="numberDecimal"
                            android:textColor="@color/texto_primario"
                            android:maxLines="1" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Precio subsidiado -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/CampoTexto"
                        android:hint="@string/campo_precio_subsidiado"
                        android:layout_marginBottom="12dp"
                        app:hintTextColor="@color/primario_oscuro">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/campoPrecioSubsidiado"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="numberDecimal"
                            android:textColor="@color/texto_primario"
                            android:maxLines="1" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Decreto -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/CampoTexto"
                        android:hint="@string/campo_decreto"
                        android:layout_marginBottom="16dp"
                        app:hintTextColor="@color/primario_oscuro">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/campoDecreto"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text"
                            android:textColor="@color/texto_primario"
                            android:maxLines="1" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Mensaje de error -->
                    <TextView
                        android:id="@+id/textoError"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/error"
                        android:textSize="14sp"
                        android:visibility="gone"
                        android:layout_marginBottom="8dp" />

                    <!-- Botón Guardar -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/botonGuardarRegla"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:text="@string/boton_guardar_regla"
                        android:textSize="16sp"
                        android:textAllCaps="false"
                        app:backgroundTint="@color/primario"
                        app:cornerRadius="12dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Lista de reglas activas -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/titulo_reglas_activas"
                style="@style/TituloSeccion" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/listaReglas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />

            <TextView
                android:id="@+id/textoSinReglas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/sin_registros"
                android:textSize="14sp"
                android:textColor="@color/texto_secundario"
                android:gravity="center"
                android:padding="32dp"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
