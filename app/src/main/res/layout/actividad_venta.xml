<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/fondo">

    <!-- Barra superior -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/secundario_oscuro"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Registrar Venta"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/texto_sobre_primario" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Valide el subsidio y registre la transacción"
            android:textSize="13sp"
            android:textColor="@color/texto_sobre_primario"
            android:alpha="0.8"
            android:layout_marginTop="4dp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Paso 1: Datos del combustible -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="1. Datos de la venta"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/texto_primario"
                        android:layout_marginBottom="12dp" />

                    <!-- Nombre estación + combustible -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="12dp">

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="Nombre estación"
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                            android:layout_marginEnd="8dp">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/campoEstacionVenta"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Combustible"
                                android:textSize="12sp"
                                android:textColor="@color/texto_secundario"
                                android:layout_marginBottom="4dp" />

                            <Spinner
                                android:id="@+id/spinnerCombustibleVenta"
                                android:layout_width="match_parent"
                                android:layout_height="48dp"
                                android:background="@android:drawable/btn_dropdown" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Litros -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Litros a despachar"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/campoLitrosVenta"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="numberDecimal" />
                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Paso 2: Validación de subsidio -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="2. Verificar subsidio"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/texto_primario"
                        android:layout_marginBottom="12dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="Placa del vehículo"
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                            android:layout_marginEnd="8dp">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/campoPlacaVenta"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="textCapCharacters" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/botonVerificarSubsidio"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Verificar"
                            android:textAllCaps="false"
                            app:cornerRadius="8dp"
                            app:backgroundTint="@color/informacion" />
                    </LinearLayout>

                    <!-- Resultado subsidio (oculto hasta verificar) -->
                    <LinearLayout
                        android:id="@+id/panelResultadoSubsidio"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="12dp"
                        android:padding="12dp"
                        android:background="@color/superficie_variante"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/textoResultadoSubsidio"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/textoTipoVehiculoVenta"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="13sp"
                            android:textColor="@color/texto_secundario"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Paso 3: Resumen y precio -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="3. Resumen de la transacción"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/texto_primario"
                        android:layout_marginBottom="12dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Precio por litro:"
                            android:textSize="14sp"
                            android:textColor="@color/texto_secundario" />

                        <TextView
                            android:id="@+id/textoPrecioUnitarioVenta"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="$—"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/texto_primario" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="TOTAL A COBRAR:"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/texto_primario" />

                        <TextView
                            android:id="@+id/textoTotalVenta"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="$—"
                            android:textSize="24sp"
                            android:textStyle="bold"
                            android:textColor="@color/exito" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Factura electrónica por correo -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <CheckBox
                        android:id="@+id/checkEnviarFactura"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="¿Desea recibir la factura al correo electrónico?"
                        android:textSize="14sp"
                        android:textColor="@color/texto_primario" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/contenedorCorreoFactura"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Correo electrónico del cliente"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_marginTop="8dp"
                        android:visibility="gone">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/campoCorreoFactura"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textEmailAddress" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/botonConfirmarVenta"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:text="Confirmar Venta y Generar Factura"
                android:textAllCaps="false"
                android:textSize="16sp"
                app:cornerRadius="12dp"
                app:backgroundTint="@color/exito" />

        </LinearLayout>
    </ScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/botonVolverVenta"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="@string/volver"
        android:textSize="16sp"
        android:textAllCaps="false"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_margin="16dp" />

</LinearLayout>
