<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/fondo">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/secundario_oscuro"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="💼 Saldos del Sistema"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/texto_sobre_primario" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Vista de solo lectura — total de saldo por usuario"
            android:textSize="13sp"
            android:textColor="@color/texto_sobre_primario"
            android:alpha="0.85"
            android:layout_marginTop="4dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="14dp"
        android:background="@color/superficie">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Saldo total del sistema:"
            android:textSize="13sp"
            android:textColor="@color/texto_secundario" />
        <TextView
            android:id="@+id/textoSaldoTotalSistema"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/exito" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/listaSaldos"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="12dp"
        android:clipToPadding="false" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/botonVolverSaldos"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="@string/volver"
        android:textSize="16sp"
        android:textAllCaps="false"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_margin="16dp" />
</LinearLayout>
