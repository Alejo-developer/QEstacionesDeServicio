<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/fondo">

    <!-- Barra superior -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/primario_oscuro"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/titulo_control_inventario"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/texto_sobre_primario" />

        <TextView
            android:id="@+id/textoSaldoActual"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/saldo_inicial"
            android:textSize="18sp"
            android:textColor="@color/texto_sobre_primario"
            android:textStyle="bold"
            android:layout_marginTop="8dp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Formulario -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Tipo movimiento -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/campo_tipo_movimiento"
                        android:textSize="12sp"
                        android:textColor="@color/texto_secundario"
                        android:layout_marginBottom="4dp" />

                    <Spinner
                        android:id="@+id/spinnerTipoMovimiento"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@android:drawable/btn_dropdown"
                        android:layout_marginBottom="12dp" />

                    <!-- Tipo combustible -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/campo_tipo_combustible"
                        android:textSize="12sp"
                        android:textColor="@color/texto_secundario"
                        android:layout_marginBottom="4dp" />

                    <Spinner
                        android:id="@+id/spinnerCombustibleInv"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@android:drawable/btn_dropdown"
                        android:layout_marginBottom="12dp" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/campo_volumen_litros"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_marginBottom="12dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/campoVolumenInv"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="numberDecimal" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/campo_motivo"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_marginBottom="16dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/campoMotivo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textMultiLine"
                            android:minLines="2" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/botonRegistrarMovimiento"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:text="@string/boton_registrar_movimiento"
                        android:textAllCaps="false"
                        android:textSize="16sp"
                        app:cornerRadius="12dp"
                        app:backgroundTint="@color/primario_oscuro" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Historial de movimientos -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/titulo_historial_movimientos"
                style="@style/TituloSeccion"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/textoSinMovimientos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/sin_registros"
                android:textAlignment="center"
                android:textColor="@color/texto_secundario"
                android:padding="24dp"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/listaMovimientos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />

        </LinearLayout>
    </ScrollView>

    <!-- Botón Volver -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/botonVolverInventario"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="@string/volver"
        android:textSize="16sp"
        android:textAllCaps="false"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_margin="24dp" />

</LinearLayout>
