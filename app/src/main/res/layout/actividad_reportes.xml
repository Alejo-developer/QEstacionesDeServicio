<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/fondo">

    <!-- Barra superior -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/primario_oscuro"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/titulo_reportes"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/texto_sobre_primario" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/subtitulo_reportes"
            android:textSize="13sp"
            android:textColor="@color/texto_sobre_primario"
            android:layout_marginTop="4dp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Tarjeta PDF -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/reporte_pdf_titulo"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/primario_oscuro"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/reporte_pdf_desc"
                        android:textSize="13sp"
                        android:textColor="@color/texto_secundario"
                        android:layout_marginBottom="16dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/botonGenerarPDF"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:text="@string/boton_generar_pdf"
                        android:textAllCaps="false"
                        android:textSize="15sp"
                        app:cornerRadius="12dp"
                        app:backgroundTint="@color/primario_oscuro" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Tarjeta CSV -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/reporte_csv_titulo"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/primario_oscuro"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/reporte_csv_desc"
                        android:textSize="13sp"
                        android:textColor="@color/texto_secundario"
                        android:layout_marginBottom="16dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/botonGenerarCSV"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:text="@string/boton_generar_csv"
                        android:textAllCaps="false"
                        android:textSize="15sp"
                        app:cornerRadius="12dp"
                        app:backgroundTint="@color/primario_oscuro" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- HU-12: Tarjeta reporte por decreto -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/reporte_decreto_titulo"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/primario_oscuro"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/reporte_decreto_desc"
                        android:textSize="13sp"
                        android:textColor="@color/texto_secundario"
                        android:layout_marginBottom="12dp" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/campo_filtro_decreto"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_marginBottom="12dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/campoFiltroDecreto"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text"
                            android:hint="@string/campo_filtro_decreto" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/botonReportePorDecreto"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:text="@string/boton_reporte_decreto"
                        android:textAllCaps="false"
                        android:textSize="15sp"
                        app:cornerRadius="12dp"
                        app:backgroundTint="@color/primario_oscuro" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Estado del reporte -->
            <TextView
                android:id="@+id/textoEstadoReporte"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textColor="@color/texto_secundario"
                android:padding="12dp"
                android:visibility="gone" />

        </LinearLayout>
    </ScrollView>

    <!-- Boton Volver -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/botonVolverReportes"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="@string/volver"
        android:textSize="16sp"
        android:textAllCaps="false"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_margin="24dp" />

</LinearLayout>
