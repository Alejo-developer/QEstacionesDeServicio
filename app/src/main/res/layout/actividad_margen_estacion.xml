<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/fondo">

    <!-- Barra superior -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/primario_oscuro"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Mi Precio de Venta"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/texto_sobre_primario" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Configura el margen sobre el precio de referencia"
            android:textSize="13sp"
            android:textColor="@color/texto_sobre_primario"
            android:alpha="0.8"
            android:layout_marginTop="4dp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Nombre de la estación -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Nombre de tu estación"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_marginBottom="16dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/campoNombreEstacion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Card: ACPM -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="⛽ ACPM"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/texto_primario"
                        android:layout_marginBottom="8dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Ref. regulador:"
                            android:textSize="13sp"
                            android:textColor="@color/texto_secundario" />

                        <TextView
                            android:id="@+id/textoRefAcpm"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="$—"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/informacion" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="8dp">

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="Margen COP/litro (ej: 1000 o -500)"
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                            android:layout_marginEnd="8dp">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/campoMargenAcpm"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="numberSigned" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Tu precio:"
                                android:textSize="11sp"
                                android:textColor="@color/texto_secundario" />

                            <TextView
                                android:id="@+id/textoPrecioVentaAcpm"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="$—"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:textColor="@color/exito" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Card: Gasolina Corriente -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="⛽ Gasolina Corriente"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/texto_primario"
                        android:layout_marginBottom="8dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Ref. regulador:"
                            android:textSize="13sp"
                            android:textColor="@color/texto_secundario" />

                        <TextView
                            android:id="@+id/textoRefCorriente"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="$—"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/informacion" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="8dp">

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="Margen COP/litro"
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                            android:layout_marginEnd="8dp">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/campoMargenCorriente"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="numberSigned" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Tu precio:"
                                android:textSize="11sp"
                                android:textColor="@color/texto_secundario" />

                            <TextView
                                android:id="@+id/textoPrecioVentaCorriente"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="$—"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:textColor="@color/exito" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Card: Gasolina Extra -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="⛽ Gasolina Extra"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/texto_primario"
                        android:layout_marginBottom="8dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Ref. regulador:"
                            android:textSize="13sp"
                            android:textColor="@color/texto_secundario" />

                        <TextView
                            android:id="@+id/textoRefExtra"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="$—"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/informacion" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="8dp">

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="Margen COP/litro"
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                            android:layout_marginEnd="8dp">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/campoMargenExtra"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="numberSigned" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Tu precio:"
                                android:textSize="11sp"
                                android:textColor="@color/texto_secundario" />

                            <TextView
                                android:id="@+id/textoPrecioVentaExtra"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="$—"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:textColor="@color/exito" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/botonGuardarMargenes"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Guardar Precios de Venta"
                android:textAllCaps="false"
                android:textSize="16sp"
                app:cornerRadius="12dp"
                app:backgroundTint="@color/primario_oscuro" />

        </LinearLayout>
    </ScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/botonVolverMargen"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="@string/volver"
        android:textSize="16sp"
        android:textAllCaps="false"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_margin="16dp" />

</LinearLayout>
