<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.QEstaciones" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/primario</item>
        <item name="colorPrimaryDark">@color/primario_oscuro</item>
        <item name="colorAccent">@color/secundario</item>
        <item name="colorOnPrimary">@color/texto_sobre_primario</item>
        <item name="colorSecondary">@color/secundario</item>
        <item name="colorOnSecondary">@color/texto_sobre_secundario</item>
        <item name="android:statusBarColor">@color/primario_oscuro</item>
        <item name="android:windowBackground">@color/fondo</item>
    </style>

    <!-- Estilo para botones primarios -->
    <style name="BotonPrimario" parent="Widget.Material3.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="backgroundTint">@color/primario</item>
        <item name="cornerRadius">12dp</item>
    </style>

    <!-- Estilo para botones secundarios -->
    <style name="BotonSecundario" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="strokeColor">@color/primario</item>
        <item name="cornerRadius">12dp</item>
    </style>

    <!-- Estilo para campos de texto -->
    <style name="CampoTexto" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="boxStrokeColor">@color/primario</item>
    </style>

    <!-- Estilo para tarjetas -->
    <style name="TarjetaEstilo">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">4dp</item>
        <item name="cardBackgroundColor">@color/tarjeta_fondo</item>
    </style>

    <!-- Estilo para títulos de sección -->
    <style name="TituloSeccion">
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/texto_primario</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingTop">16dp</item>
        <item name="android:paddingBottom">8dp</item>
    </style>

    <!-- Estilo para menú principal -->
    <style name="BotonMenu" parent="Widget.Material3.Button.ElevatedButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">72dp</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:gravity">center_vertical|start</item>
        <item name="android:paddingStart">24dp</item>
        <item name="cornerRadius">16dp</item>
    </style>
</resources>
